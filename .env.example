# Server
# macOS AirPlay holds port 5000 — use 5001 (frontend points here)
PORT=5001
NODE_ENV=development

# Optional: comma-separated list of allowed CORS origins.
# Leave blank to use defaults (http://localhost:5173, http://localhost:5174, plus 127.0.0.1).
# Example: CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Snowflake
SNOWFLAKE_ACCOUNT=your-snowflake-account
SNOWFLAKE_USERNAME=your-snowflake-username
SNOWFLAKE_PASSWORD=your-snowflake-password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=PTE_EXAM_PREP_PLATFORM
SNOWFLAKE_SCHEMA=PUBLIC

# Firebase Admin (option 1: service account file at project root)
# Place serviceAccountKey.json at the repo root (it is gitignored).

# Firebase Admin (option 2: env-var credentials, used when serviceAccountKey.json is absent)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Admin (option 3: full JSON string)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
